# Global .gitignore: editor/OS junk and secrets only.
# This file is meant to be used with: git config --global core.excludesfile ~/.gitignore_global
#
# A global ignore applies to EVERY repository on the machine and is invisible to
# collaborators, so it only lists files that no repository should ever commit
# (plus __pycache__/, which Python writes beside every module it imports).
# Language and build patterns (node_modules/, __pycache__/, dist/, lockfiles,
# bin/, lib/, ...) belong in each project's own .gitignore, where they are
# visible and versioned. Globally ignoring them silently hides files that some
# projects must commit (package-lock.json, a bin/ of scripts, a lib/ package).
#
# One deliberate exception: the secret patterns at the bottom (*.pem, *.key, ...)
# also match some files that are safe to commit, such as a public CA bundle
# (ca-bundle.pem), a test certificate, or a Keynote deck (deck.key). They are
# kept broad on purpose: a missed private key is a leak, a missed CA bundle is
# only an extra step. Git says nothing about ignored files, so if one of those
# is missing from `git status`, check with `git check-ignore -v <file>`, then
# either add it once with `git add -f <file>` (git keeps tracking it after
# that), or un-ignore it for everyone in the project's own .gitignore with a
# negation such as `!ca-bundle.pem` (project rules override this file).

# ============================================================================
# Editors
# ============================================================================

# Vim / Neovim
*.swp
*.swo
*.un~
.netrwhist
Session.vim

# Emacs
*~
\#*\#
.\#*

# JetBrains IDEs (IntelliJ, PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.factorypath
.sts4-cache/

# Sublime Text (per-user workspace state)
*.sublime-workspace

# VS Code extensions that write output into the workspace
.VSCodeCounter/

# Claude Code per-user settings
**/.claude/settings.local.json

# Editor, merge-tool and scratch backups
*.bak
*.backup
*.orig
*.tmp
*.temp

# ============================================================================
# OS files
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.TemporaryItems
*~.nib

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux (KDE Dolphin folder settings)
.directory

# ============================================================================
# Interpreter caches (generated next to source, never committed)
# ============================================================================

__pycache__/

# ============================================================================
# Secrets and local credentials
# ============================================================================
# Broad on purpose; see the header for how to commit a public .pem or a .key
# that is not a secret. A pattern with a slash in the middle (a/b) only matches
# at the repository root, so nested paths need a leading **/.

.env
.env.local
.env.*.local
.secrets
*.pem
*.key
credentials.json
oauth_token
**/.aws/credentials
.ssh/
.pgpass
